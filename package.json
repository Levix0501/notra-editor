{
  "name": "notra-editor-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @notra/editor build",
    "lint": "biome ci",
    "format": "biome check --write",
    "typecheck": "pnpm build && pnpm --recursive --workspace-concurrency=1 typecheck",
    "test": "pnpm build && pnpm --filter @notra/editor test",
    "test:e2e": "pnpm build && pnpm --filter @notra/e2e test:playground",
    "test:ssr": "pnpm build && pnpm --filter @notra/e2e test:ssr",
    "check:package": "pnpm build && pnpm --filter @notra/editor check:package"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  }
}
