{
  "name": "notra-editor",
  "version": "3.0.0-canary.1",
  "description": "A block-based rich text editor for React with a Notion-style editing experience, built on Tiptap, shadcn/ui and Tailwind CSS.",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "notion",
    "block-editor",
    "tiptap",
    "prosemirror",
    "react",
    "shadcn",
    "tailwindcss"
  ],
  "homepage": "https://github.com/Levix0501/notra-editor/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/Levix0501/notra-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Levix0501/notra-editor.git",
    "directory": "packages/editor"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "@notra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@notra/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && tailwindcss --input ./src/styles.css --output ./dist/styles.css --minify && publint --strict --pack npm",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "~3.33.0",
    "@tiptap/extension-code-block-lowlight": "~3.33.0",
    "@tiptap/extension-details": "~3.33.0",
    "@tiptap/extension-file-handler": "~3.33.0",
    "@tiptap/extension-heading": "~3.33.0",
    "@tiptap/extension-highlight": "~3.33.0",
    "@tiptap/extension-image": "~3.33.0",
    "@tiptap/extension-list": "~3.33.0",
    "@tiptap/extension-paragraph": "~3.33.0",
    "@tiptap/extension-table": "~3.33.0",
    "@tiptap/extension-text-style": "~3.33.0",
    "@tiptap/extension-typography": "~3.33.0",
    "@tiptap/extensions": "~3.33.0",
    "@tiptap/markdown": "~3.33.0",
    "@tiptap/pm": "~3.33.0",
    "@tiptap/react": "~3.33.0",
    "@tiptap/starter-kit": "~3.33.0",
    "@tiptap/suggestion": "~3.33.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.70.0",
    "marked": "^17.0.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
