{
  "name": "notra-editor-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@notra-editor/playground",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=notra-editor && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
